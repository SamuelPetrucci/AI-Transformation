    "analyze": "ANALYZE=true npm run build",
    "content-agent": "node scripts/content-agent/run.mjs",
    "content-agent:write": "node scripts/content-agent/run.mjs --write"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "@types/nodemailer": "^7.0.1",
